# Copy to .env and fill in your Spotify credentials.
# Used by Docker Compose (local + production).

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SESSION_SECRET=change_me_to_a_long_random_string

# --- Local Docker (docker-compose.local.yml) ---
# CLIENT_URL=http://127.0.0.1:8080
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/auth/callback

# --- Production (docker-compose.prod.yml overrides these) ---
# CLIENT_URL=https://analyser.hendrik.tech
# SPOTIFY_REDIRECT_URI=https://analyser.hendrik.tech/api/auth/callback

# --- Dev without Docker (npm run dev) ---
CLIENT_URL=http://127.0.0.1:5173
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/auth/callback
PORT=3001
USE_HTTPS=false
